{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlowNote",
  "version": "0.24.0",
  "identifier": "dev.flownote.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "./scripts/build-grammar.sh && npm run dev",
    "beforeBuildCommand": "./scripts/build-grammar.sh && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FlowNote",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 720,
        "minHeight": 480,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        },
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data: https://cdn.jsdelivr.net https://esm.sh",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "worker-src": "'self' blob: data:",
        "media-src": "'self' data: blob:",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data: https://cdn.jsdelivr.net https://esm.sh",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: http://localhost:1420 ws://localhost:1420",
        "worker-src": "'self' blob: data:",
        "media-src": "'self' data: blob:",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Productivity",
    "shortDescription": "Éditeur de blocs pour vault Obsidian",
    "longDescription": "Éditeur de notes par blocs qui travaille directement sur les fichiers Markdown d'un vault Obsidian, avec gestionnaire Git intégré.",
    "copyright": "© 2026 Florent Fougères",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    },
    "externalBin": [
      "binaries/flownote-grammar"
    ]
  }
}
